# Copy to .env and fill in values: cp .env.sample .env
# .env is git-ignored. The server loads it at startup (apps/server/src/env.ts).
# Variables set in your shell override values in this file.

# Required for the AI assist chat in the item editor. Get a key at https://openrouter.ai/keys
# Leave empty to turn AI assist off. Restart the server after you change it.
OPENROUTER_API_KEY=

# Optional overrides
# PORT=8123
# HOST=127.0.0.1
# MOCK_PUBLISH=1
# Use absolute paths. Defaults: data/, config.json, secrets.json in the repo root.
# SYS_DATA_DIR=/absolute/path/to/data
# SYS_CONFIG=/absolute/path/to/config.json
# SYS_SECRETS=/absolute/path/to/secrets.json
